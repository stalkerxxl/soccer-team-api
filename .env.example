APP_ENV=local
LOG_LEVEL=info

HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

DB_HOST=localhost
DB_PORT=5432
DB_NAME=soccer_team_api
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable
DB_CONNECT_TIMEOUT=5s

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=60m
AUTH_PASSWORD_MIN_LEN=5
AUTH_PASSWORD_MAX_LEN=72

DEFAULT_LOCALE=en
