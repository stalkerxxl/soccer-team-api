                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json();",
                  "pm.test('Players list is not empty', function () {",
                  "    pm.expect(Array.isArray(data)).to.eql(true);",
                  "    pm.expect(data.length).to.be.greaterThan(0);",
                  "});",
                  "if (Array.isArray(data) && data.length > 0) {",
                  "    pm.collectionVariables.set('sellerPlayerId', String(data[0].id));",
                  "    if (data[0].country_id) {",
                  "        pm.collectionVariables.set('sellerPlayerCountryId', String(data[0].country_id));",
